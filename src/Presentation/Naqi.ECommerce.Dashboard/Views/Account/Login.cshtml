@* src/Presentation/Naqi.ECommerce.Dashboard/Views/Account/Login.cshtml *@
@using Naqi.ECommerce.Application
@using System.Text.Json
@model Naqi.ECommerce.Dashboard.ViewModels.LoginViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Naqi.ECommerce.Application.Resources.SharedResource> Localizer
@{
    Layout = null; // login page renders standalone, no admin shell/sidebar

    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = LocalizationDependencyInjection.IsRtl(currentCulture);
    var dir = isRtl ? "rtl" : "ltr";

    ViewData["Title"] = Localizer["Login"];

    // Slider images - swap these paths for your real assets under wwwroot/images/login/
    var imagesLtr = new[] { "/images/login/login-image1.png", "/images/login/login-image2.png", "/images/login/login-image3.png" };
    var imagesRtl = new[] { "/images/login/login-image-rtl1.png", "/images/login/login-image-rtl2.png", "/images/login/login-image-rtl3.png" };

    var overlays = new[]
    {
        new { heading = Localizer["Overlay1Heading"].Value, subtext = Localizer["Overlay1Subtext"].Value },
        new { heading = Localizer["Overlay2Heading"].Value, subtext = Localizer["Overlay2Subtext"].Value },
        new { heading = Localizer["Overlay3Heading"].Value, subtext = Localizer["Overlay3Subtext"].Value },
    };

    var jsonOptions = new JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Naqi</title>
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/dashboard-login.css" />
</head>
<body>
    <div class="login-page-wrapper">
        <div class="container-fluid p-0 m-0 h-100">
            <div class="row h-100 m-0 w-100">

                @* ================= FORM ================= *@
                <div class="col-12 col-md-6 login-form-col">
                    <img src="~/images/naqi-logo.png" alt="Naqi logo" class="login-logo" />

                    <div class="login-form-wrapper">
                        <form asp-controller="Account" asp-action="Login"
                              asp-route-returnUrl="@Model.ReturnUrl"
                              method="post" class="login-form">

                            <img src="~/images/naqi-logo.png" alt="Login logo" class="login-centered-logo" />
                            <p class="login-title">@Localizer["Login"]</p>
                            <p class="login-subtitle">@Localizer["LoginSubtitle"]</p>

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none-if-empty text-center"></div>

                       
                            <input type="hidden" asp-for="System" id="System" />

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control inputField" autocomplete="username" autofocus />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control inputField" autocomplete="current-password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="mb-3 form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label"></label>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2">
                                <span>@Localizer["Login"]</span>
                            </button>

                            @* ---- Language switcher + copyright, bottom of form ---- *@
                            <div class="login-footer-row">
                                <div class="dropdown login-language-dropdown">
                                    <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fa-solid fa-globe"></i>
                                        <span>@(currentCulture == "ar" ? Localizer["LanguageArabic"].Value : Localizer["LanguageEnglish"].Value)</span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item @(currentCulture == "en" ? "active-language" : "")"
                                               asp-controller="Culture" asp-action="Set"
                                               asp-route-culture="en"
                                               asp-route-returnUrl="@Context.Request.Path">
                                                <span>@Localizer["LanguageEnglish"]</span>
                                                @if (currentCulture == "en")
                                                {
                                                    <i class="fa-solid fa-check"></i>
                                                }
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item @(currentCulture == "ar" ? "active-language" : "")"
                                               asp-controller="Culture" asp-action="Set"
                                               asp-route-culture="ar"
                                               asp-route-returnUrl="@Context.Request.Path">
                                                <span>@Localizer["LanguageArabic"]</span>
                                                @if (currentCulture == "ar")
                                                {
                                                    <i class="fa-solid fa-check"></i>
                                                }
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                <p class="login-copyright">© @DateTime.UtcNow.Year @Localizer["CopyrightName"]</p>
                            </div>
                        </form>
                    </div>
                </div>

                @* ================= SLIDER ================= *@
                <div class="col-md-6 d-none d-md-flex login-slider-col">
                    <img id="login-slide-image"
                         src="@(isRtl? imagesRtl[0] : imagesLtr[0])"
                         alt="login visual"
                         class="login-slide-image fade-in"
                         data-rtl="@isRtl.ToString().ToLower()"
                         data-images-ltr='@Html.Raw(JsonSerializer.Serialize(imagesLtr, jsonOptions))'
                         data-images-rtl='@Html.Raw(JsonSerializer.Serialize(imagesRtl, jsonOptions))'
                         data-overlays='@Html.Raw(JsonSerializer.Serialize(overlays, jsonOptions))' />

                    <div class="login-overlay">
                        <p id="login-overlay-heading" class="login-overlay-heading">@overlays[0].heading</p>
                        <p id="login-overlay-subtext" class="login-overlay-subtext">@overlays[0].subtext</p>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
     <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/dashboard-login.js"></script>
</body>
</html>

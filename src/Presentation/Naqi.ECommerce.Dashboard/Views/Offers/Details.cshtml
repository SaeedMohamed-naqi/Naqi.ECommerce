@* src/Presentation/Naqi.ECommerce.Dashboard/Views/Offers/Details.cshtml *@
@using Naqi.ECommerce.Application.Features.Offers.Queries
@model OfferGroupDetailsDto
@{
    ViewData["Title"] = Model.NameEn;
    Layout = "_Layout";
}

@section Styles {
    <style>
        .product-details-tab-content {
            background: #ffffff;
            border-bottom-left-radius: 1rem;
            border-bottom-right-radius: 1rem;
        }

        body.dark-mode .product-details-tab-content {
            background: #1c1f24;
        }
    </style>
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-circle" style="width:36px;height:36px;" title="@Localizer["Back"]">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <div>
            <h4 class="mb-0">@Model.NameEn</h4>
            <div class="table-secondary-text">@Model.NameAr</div>
        </div>
    </div>
    <span class="mono-chip">@Model.ExternalOfferGroupId</span>
</div>

<div class="row g-4">
    @* ---------------- Left: icon + quick facts ---------------- *@
    <div class="col-lg-4">
        <div class="border rounded-4 p-3 mb-3" style="border-color: var(--naqi-border) !important;">
            @if (!string.IsNullOrEmpty(Model.IconUrl))
            {
                <img src="@Model.IconUrl" alt="@Model.NameEn" class="w-100 rounded-3" style="background:#f8f9fa;" />
            }
            else
            {
                <div class="w-100 rounded-3 d-flex align-items-center justify-content-center table-thumb-placeholder" style="height:180px;">
                    <i class="fa-solid fa-tag fa-2x"></i>
                </div>
            }

            <div class="mt-3 d-flex flex-column gap-2">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="table-secondary-text">@Localizer["Color"]</span>
                    @if (!string.IsNullOrEmpty(Model.Color))
                    {
                        <span class="d-inline-flex align-items-center gap-2">
                            <span class="d-inline-block rounded-circle" style="width:16px;height:16px;background:@Model.Color;border:1px solid #ddd;"></span>
                            <span class="mono-chip">@Model.Color</span>
                        </span>
                    }
                    else
                    {
                        <span class="table-secondary-text">-</span>
                    }
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="table-secondary-text">@Localizer["Big"]</span>
                    @if (Model.IsBig)
                    {
                        <i class="fa-solid fa-star text-warning"></i>
                    }
                    else
                    {
                        <span class="table-secondary-text">-</span>
                    }
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="table-secondary-text">@Localizer["Products"]</span>
                    <span class="pill-badge">@Model.ProductCount</span>
                </div>
                @if (Model.ExpireAtUtc.HasValue)
                {
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="table-secondary-text">@Localizer["EndsAt"]</span>
                        <span id="detail-ends-at" data-utc="@Model.ExpireAtUtc?.ToString("O")">-</span>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ---------------- Right: tabbed detail sections ---------------- *@
    <div class="col-lg-8">
        <div class="border rounded-4" style="border-color: var(--naqi-border) !important;">
            <ul class="nav nav-tabs px-3 pt-2" id="offerDetailsTabs" role="tablist" style="border-bottom-color: var(--naqi-border);">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-general" type="button">@Localizer["General"]</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-products" type="button">@Localizer["Products"] (@Model.Products.Count)</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-sync" type="button">@Localizer["SyncInfo"]</button>
                </li>
            </ul>

            <div class="tab-content product-details-tab-content p-4">
                @* ---- General ---- *@
                <div class="tab-pane fade show active" id="tab-general" role="tabpanel">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 table-secondary-text">@Localizer["Offers"] (EN)</dt>
                        <dd class="col-sm-8">@Model.NameEn</dd>

                        <dt class="col-sm-4 table-secondary-text">@Localizer["Offers"] (AR)</dt>
                        <dd class="col-sm-8">@Model.NameAr</dd>

                        <dt class="col-sm-4 table-secondary-text">@Localizer["ExternalId"]</dt>
                        <dd class="col-sm-8"><span class="mono-chip">@Model.ExternalOfferGroupId</span></dd>

                        <dt class="col-sm-4 table-secondary-text">@Localizer["Big"]</dt>
                        <dd class="col-sm-8">
                            <span class="status-badge @(Model.IsBig ? "status-success" : "status-warning")">
                                @(Model.IsBig? Localizer["Yes"] : Localizer["No"])
                            </span>
                        </dd>

                        @if (Model.ExpireAtUtc.HasValue)
                        {
                            <dt class="col-sm-4 table-secondary-text">@Localizer["EndsAt"]</dt>
                            <dd class="col-sm-8" id="detail-ends-at-general" data-utc="@Model.ExpireAtUtc?.ToString("O")">-</dd>
                        }
                    </dl>
                </div>

                @* ---- Products ---- *@
                <div class="tab-pane fade" id="tab-products" role="tabpanel">
                    @if (Model.Products.Count == 0)
                    {
                        <div class="table-empty-state">
                            <i class="fa-solid fa-box"></i>
                            @Localizer["NoProductsInOffer"]
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>@Localizer["Products"]</th>
                                        <th>@Localizer["Price"]</th>
                                        <th>@Localizer["Active"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in Model.Products)
                                    {
                                        <tr class="product-row" style="cursor:pointer;" data-href="@Url.Action("Details", "Products", new { id = product.Id })">
                                            <td style="width:56px;">
                                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                                {
                                                    <img src="@product.ImageUrl" alt="@product.NameEn" class="table-thumb" />
                                                }
                                                else
                                                {
                                                    <div class="table-thumb-placeholder"><i class="fa-solid fa-image"></i></div>
                                                }
                                            </td>
                                            <td>
                                                <div class="table-primary-text">@product.NameEn</div>
                                                <div class="table-secondary-text">@product.NameAr</div>
                                            </td>
                                            <td><span class="amount-current">@product.Price.ToString("N2")</span></td>
                                            <td>
                                                <span class="status-badge @(product.IsActive ? "status-success" : "status-danger")">
                                                    @(product.IsActive? Localizer["Yes"] : Localizer["No"])
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                @* ---- Sync / audit info ---- *@
                <div class="tab-pane fade" id="tab-sync" role="tabpanel">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 table-secondary-text">@Localizer["Created"]</dt>
                        <dd class="col-sm-8" id="detail-created-at" data-utc="@Model.CreatedAtUtc.ToString("O")">-</dd>

                        <dt class="col-sm-4 table-secondary-text">@Localizer["LastModified"]</dt>
                        <dd class="col-sm-8" id="detail-modified-at" data-utc="@Model.LastModifiedAtUtc?.ToString("O")">-</dd>
                    </dl>

                    <div class="alert alert-light border mt-3 mb-0" style="border-color: var(--naqi-border) !important;">
                        <i class="fa-solid fa-circle-info me-1 text-muted"></i>
                        <span class="table-secondary-text">@Localizer["SyncInfoNote"]</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            document.querySelectorAll('[data-utc]').forEach(function (el) {
                const utcValue = el.getAttribute('data-utc');
                el.textContent = utcValue ? NaqiDateTime.toLocal(utcValue) : '-';
            });

            document.querySelectorAll('.product-row[data-href]').forEach(function (row) {
                row.addEventListener('click', function () {
                    window.location.href = row.dataset.href;
                });
            });
        });
    </script>
}

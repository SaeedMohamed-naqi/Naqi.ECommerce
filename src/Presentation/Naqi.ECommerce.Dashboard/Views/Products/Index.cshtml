@* src/Presentation/Naqi.ECommerce.Dashboard/Views/Products/Index.cshtml *@
@{
    ViewData["Title"] = Localizer["Products"];
    Layout = "_Layout";
}

@* No @section Styles / DataTables CDN links here - those are now global
   in _Layout.cshtml, along with the shared datatable-theme.css. Only
   page-specific CSS (if any) would go in a Styles section. *@

@Html.AntiForgeryToken()

<div class="list-toolbar">
    <div class="list-toolbar-left">
        <h4 class="list-title">@Localizer["Products"]</h4>
        <span class="list-count-badge">
            <i class="fa-solid fa-box"></i>
            <span id="products-count">0</span> @Localizer["Products"]
        </span>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
        <div class="list-search-wrapper">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="products-search" class="list-search-input" placeholder="@Localizer["Search"]" />
        </div>

        <button id="sync-products-btn" type="button" class="btn btn-pill-primary d-flex align-items-center gap-2"
                data-success-title="@Localizer["SyncCompleteTitle"]"
                data-success-text="@Localizer["SyncCompleteText"]"
                data-error-title="@Localizer["SyncFailedTitle"]">
            <i class="fa-solid fa-rotate" id="sync-icon"></i>
            <span id="sync-label">@Localizer["SyncProducts"]</span>
        </button>
    </div>
</div>

<div class="table-responsive">
    <table id="products-table" class="table w-100">
        <thead>
            <tr>
                <th></th>
                <th>@Localizer["Products"]</th>
                <th>@Localizer["ExternalId"]</th>
                <th>@Localizer["Categories"]</th>
                <th>@Localizer["Price"]</th>
                <th>@Localizer["Quantity"]</th>
                <th>@Localizer["LastSynced"]</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
    @* All shared config (dom layout, RTL language file, pagination
       styling, search debounce, count badge) lives in datatable-common.js
       now - this page only supplies the url, columns, and page-specific
       render callbacks. *@
    <script>
        $(function () {
            const noImageIcon = '<div class="table-thumb-placeholder"><i class="fa-solid fa-image"></i></div>';

            NaqiDataTable.init('#products-table', {
                url: '@Url.Action("GetData", "Products")',
                order: [[6, 'desc']],
                countBadgeSelector: '#products-count',
                searchInputSelector: '#products-search',
                rowClickUrl: (row) => '@Url.Action("Details", "Products")' + '/' + row.id,
                emptyMessage: `<div class="table-empty-state">
                                  <i class="fa-solid fa-box-open"></i>
                                  @Localizer["NoProductsYet"]
                               </div>`,
                columns: [
                    {
                        data: 'imageUrl',
                        orderable: false,
                        render: function (data, type, row) {
                            return data
                                ? `<img src="${data}" alt="${row.nameEn}" class="table-thumb" />`
                                : noImageIcon;
                        }
                    },
                    {
                        data: null,
                        render: function (row) {
                            return `<div class="table-primary-text">${row.nameEn}</div>` +
                                   `<div class="table-secondary-text">${row.nameAr}</div>`;
                        }
                    },
                    {
                        data: 'externalProductId',
                        render: (d) => `<span class="mono-chip">${d}</span>`
                    },
                    {
                        data: 'categoryNameEn',
                        render: (d) => `<span class="pill-badge">${d}</span>`
                    },
                    {
                        data: null,
                        render: function (row) {
                            const price = Number(row.price).toFixed(2);
                            const old = row.oldPrice
                                ? `<span class="amount-old">${Number(row.oldPrice).toFixed(2)}</span>`
                                : '';
                            return `<span class="amount-current">${price}</span>${old}`;
                        }
                    },
                    {
                        data: 'stockQuantity',
                        render: function (data) {
                            const cls = data > 0 ? 'status-success' : 'status-danger';
                            return `<span class="status-badge ${cls}">${data}</span>`;
                        }
                    },
                    {
                        data: 'lastSyncedAtUtc',
                        render: function (data) {
                            return NaqiDateTime.toLocal(data);
                        }
                    }
                ]
            });
        });
    </script>
    <script src="~/js/products-sync.js"></script>
}

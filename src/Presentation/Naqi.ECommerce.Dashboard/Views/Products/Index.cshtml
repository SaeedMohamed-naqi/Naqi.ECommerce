@* src/Presentation/Naqi.ECommerce.Dashboard/Views/Products/Index.cshtml *@
@{
    ViewData["Title"] = Localizer["Products"];
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0">@Localizer["Products"]</h4>

    <button id="sync-products-btn" type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-2"
            data-success-title="@Localizer["SyncCompleteTitle"]"
            data-success-text="@Localizer["SyncCompleteText"]"
            data-error-title="@Localizer["SyncFailedTitle"]">
        <i class="fa-solid fa-rotate" id="sync-icon"></i>
        <span id="sync-label">@Localizer["SyncProducts"]</span>
    </button>
</div>

<div class="table-responsive">
    <table id="products-table" class="table table-hover align-middle w-100">
        <thead>
            <tr>
                <th></th>
                <th>@Localizer["Products"]</th>
                <th>@Localizer["ExternalId"]</th>
                <th>@Localizer["Categories"]</th>
                <th>@Localizer["Price"]</th>
                <th>@Localizer["Quantity"]</th>
                <th>@Localizer["LastSynced"]</th>
            </tr>
        </thead>
    </table>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            $('#products-table').DataTable({
                serverSide: true,
                processing: true,
                ajax: {
                    url: '@Url.Action("GetData", "Products")',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    }
                },
                order: [[6, 'desc']], // Last Synced column, newest first
                pageLength: 20,
                lengthMenu: [10, 20, 50, 100],
                language: {
                    // Arabic DataTables translation - only loaded when the
                    // page is actually in Arabic, matching this Dashboard's
                    // culture handling.
                    url: '@(CultureHelper.CurrentCulture == "ar"
                                            ? "https://cdn.datatables.net/plug-ins/1.13.8/i18n/ar.json"
                                            : "")'
            },
            columns: [
                {
                    data: 'imageUrl',
                    orderable: false,
                    render: function (data) {
                        return data
                            ? `<img src="${data}" style="width:48px;height:48px;object-fit:cover;border-radius:8px;" />`
                            : '';
                    }
                },
                {
                    data: null,
                    render: function (row) {
                        return `<div class="fw-semibold">${row.nameEn}</div>` +
                               `<div class="text-muted small">${row.nameAr}</div>`;
                    }
                },
                { data: 'externalProductId', render: (d) => `<code>${d}</code>` },
                { data: 'categoryNameEn' },
                {
                    data: null,
                    render: function (row) {
                        const price = Number(row.price).toFixed(2);
                        const old = row.oldPrice
                            ? `<span class="text-muted text-decoration-line-through small ms-1">${Number(row.oldPrice).toFixed(2)}</span>`
                            : '';
                        return `${price} ${old}`;
                    }
                },
                {
                    data: 'stockQuantity',
                    render: function (data) {
                        const cls = data > 0 ? 'bg-success' : 'bg-danger';
                        return `<span class="badge ${cls}">${data}</span>`;
                    }
                },
                {
                    data: 'lastSyncedAtUtc',
                    render: function (data) {
                        if (!data) return '-';
                        const d = new Date(data);
                        return d.toLocaleString();
                    }
                }
            ]
        });
    });
</script>
<script src="~/js/products-sync.js"></script>
}

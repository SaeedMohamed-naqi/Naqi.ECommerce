@* src/Presentation/Naqi.ECommerce.Dashboard/Views/Home/Error.cshtml *@
@model Naqi.ECommerce.Dashboard.Models.ErrorViewModel
@{
    ViewData["Title"] = Localizer["ErrorTitle"];
    Layout = "_Layout";
}

<div class="text-center py-5">
    <h2 class="mb-3">@Localizer["ErrorTitle"]</h2>
    <p class="text-muted mb-4">@Localizer["ErrorMessage"]</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">
            @Localizer["RequestId"]: <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">@Localizer["BackToDashboard"]</a>
</div>
